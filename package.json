{
  "name": "claude-subagent-gate",
  "version": "0.2.0",
  "description": "Control which model Claude Code subagents run on, before they spawn",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "subagent-gate": "./install.mjs"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",

  },
  "files": [
    "src",
    "install.mjs",
    "policy.example.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "hooks",
    "subagent",
    "cost-control",
    "model-routing"
  ]
}
